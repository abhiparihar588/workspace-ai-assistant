# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/workspace_assistant
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/workspace_assistant

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── File Uploads (Cloudinary) ────────────────────────────
MAX_FILE_SIZE_MB=5


UPLOAD_DIR=workspace_uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=workspaceaiotp@gmail.com
SMTP_PASS=your_16_character_app_password

FROM_EMAIL=workspaceaiotp@gmail.com
FROM_NAME=Workspace AI

# ─── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here